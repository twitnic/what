includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - routes
        - database
        - tests
    tmpDir: storage/framework/cache/phpstan
    phpVersion: 80400
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    checkUninitializedProperties: true
    # Larastan represents forwarded Eloquent calls and Laravel macros as static.
    # This extra strict rule rejects valid framework calls; all max-level rules stay enabled.
    strictRules:
        dynamicCallOnStaticMethod: false
